<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent that keeps the juggle-tracker batch worker running.
  Do NOT edit this template's __REPO__ placeholders by hand — run
  deploy/install-launchd.sh, which substitutes the absolute repo path and
  installs a resolved copy into ~/Library/LaunchAgents.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abeatte.juggletracker</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>-m</string>
    <string>juggle_tracker.cli</string>
    <string>watch</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- Restart the worker if it exits or crashes. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Be a good neighbour to Home Assistant / Matter: low CPU priority. -->
  <key>Nice</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>

  <!-- Throttle respawns so a crash-loop can't peg the CPU. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>__REPO__/worker.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/worker.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Ensure ffmpeg / homebrew tools are on PATH under launchd. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
