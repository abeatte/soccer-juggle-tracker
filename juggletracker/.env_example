# Native soccer-worker values loaded by systemd. This file is gitignored.
# Leave a value blank to keep the corresponding value from config.yaml.
JUGGLE_MQTT_USER=<USERNAME>
JUGGLE_MQTT_PASSWORD=<PASSWORD>

JUGGLE_RTSP_MAIN=rtsp://frigate:<PASSWORD>@<IP>:554/h264Preview_01_main
JUGGLE_MQTT_HOST=<IP>
JUGGLE_MQTT_PORT=<PORT>

JUGGLE_INBOX_DIR=/srv/juggle_inbox
JUGGLE_PROCESSED_DIR=/srv/juggle_processed
JUGGLE_HIGHSCORE_DIR=/srv/juggle_highscores
