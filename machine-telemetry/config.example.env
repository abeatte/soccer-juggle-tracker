# machine-telemetry configuration — copy to  machine-telemetry.env  and edit.
# This file holds the MQTT password, so keep it 0600 and out of git.

# --- MQTT broker (the Mosquitto that Frigate + HA already use) ---
# On the box itself the broker's 1883 port is published on the host, so
# 127.0.0.1 works. (Confirmed reachable.)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Reuse an existing broker account. Frigate uses "mqtt_broker"; the juggle
# tracker uses "mqtt_user". Use whichever real account you have a password for.
MQTT_USER=mqtt_broker
MQTT_PASS=CHANGE_ME

# --- Identity / HA discovery ---
NODE_ID=frigate_box
DEVICE_NAME=Frigate Box (MacBook Pro)
DISCOVERY_PREFIX=homeassistant

# --- Behaviour ---
# Publish interval in seconds. 15s is plenty for thermal/CPU trends and keeps
# the load off this old CPU.
INTERVAL=15
# Comma-separated container names to report CPU%/mem for. Blank to disable.
# Requires the service user to be in the `docker` group.
DOCKER_CONTAINERS=frigate
