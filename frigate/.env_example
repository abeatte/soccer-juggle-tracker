# Frigate and inbox-bridge runtime values. This file is gitignored.
# Copy the working values from your current deployment.
FRIGATE_MQTT_HOST=mosquitto
FRIGATE_MQTT_USER=<USERNAME>
FRIGATE_MQTT_PASSWORD=<PASSWORD>

FRIGATE_RTSP_FRONT_MAIN=rtsp://frigate:<PASSWORD>@<IP_ADDRESS>:554/h264Preview_01_main
FRIGATE_RTSP_FRONT_SUB=rtsp://frigate:<PASSWORD>@<IP_ADDRESS>:554/h264Preview_01_sub
FRIGATE_RTSP_FRONT_MAIN_INPUT=rtsp://<IP_ADDRESS>:8554/front_yard
FRIGATE_RTSP_FRONT_SUB_INPUT=rtsp://<IP_ADDRESS>:8554/front_yard_sub

FRIGATE_RTSP_BACK_MAIN=rtsp://frigate:<PASSWORD>@<IP_ADDRESS>:554/h264Preview_01_main
FRIGATE_RTSP_BACK_SUB=rtsp://frigate:<PASSWORD>@<IP_ADDRESS>:554/h264Preview_01_sub
FRIGATE_RTSP_BACK_MAIN_INPUT=rtsp://<IP_ADDRESS>:8554/back_yard
FRIGATE_RTSP_BACK_SUB_INPUT=rtsp://<IP_ADDRESS>:8554/back_yard_sub

# Bridge settings.
BRIDGE_MQTT_USER=<USERNAME>
BRIDGE_MQTT_PASSWORD=<PASSWORD>
JUGGLE_INBOX_HOST=/srv/juggle_inbox
FRIGATE_CAMERA_FILTER=front_yard
FRIGATE_ZONE_FILTER=grass
